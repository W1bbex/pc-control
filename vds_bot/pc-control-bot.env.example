# Environment configuration for /etc/pc-control-bot.env (systemd EnvironmentFile)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_ALLOWED_USER_ID=YOUR_TELEGRAM_USER_ID

MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=telegram_bot
MQTT_PASSWORD=YOUR_MQTT_PASSWORD

# Optional state & lock overrides
# STATE_PATH=/var/lib/pc-control-bot/state.json
# FLOW_STATE_PATH=/var/lib/pc-control-bot/flow_state.json
# BOT_LOCK_PATH=/var/lib/pc-control-bot/bot.lock
# TELEMETRY_HISTORY_DB_PATH=/var/lib/pc-control-bot/telemetry_history.db
